 // STARTING RULES
 // ==============
 
+// Semgrep pattern entry point: a single expression, or one/more statements.
+semgrepPattern
+    : eval
+    | file_input
+    ;
+
 file_input: statements? EOF;
 interactive: statement_newline;
 eval: expressions NEWLINE* EOF;
